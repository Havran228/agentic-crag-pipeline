# ============================================================================
# CRAG Pipeline configuration — copy to .env and adjust as needed.
# All services MUST remain on localhost (EU AI Act local cybersecurity sandbox).
# ============================================================================

# --- Data sources -----------------------------------------------------------
# Offline Wikipedia ZIM archive (knowledge base). The archive's own metadata
# (name, date, UUID) is extracted at runtime for provenance stamping.
ZIM_FILE_PATH="/home/havran/WikiData/wikipedia_en_all_nopic_2026-06.zim"

# --- Model caches -----------------------------------------------------------
# Hugging Face cache for the embedding model. After the first warm-up the
# pipeline runs fully offline (HF_HUB_OFFLINE is set automatically when the
# model is already cached).
HF_HOME="/home/havran/models/CRAG"

# --- Inference engine (Docker container: ai_inference_ollama) ---------------
# Must resolve to loopback; the client refuses non-local endpoints.
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama model tags. Pull with e.g. `docker exec ai_inference_ollama ollama pull qwen3:14b`.
# Ollama's default quantization is Q4_K_M GGUF (4-bit), mirroring NVFP4 efficiency.
GENERATOR_MODEL="qwen3:14b"
GRADER_MODEL="qwen3:4b"

# Embedding model (Hugging Face id, served locally via sentence-transformers).
EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"

# --- Retrieval tuning -------------------------------------------------------
# Candidate articles pulled from the ZIM Xapian full-text index per query.
TOP_K_ARTICLES=8
# Chunks kept after semantic reranking and passed to the grader.
TOP_N_CHUNKS=6
# Minimum fraction of graded chunks that must be relevant to proceed to
# generation; below this the query is rewritten (or refused).
RELEVANCE_THRESHOLD=0.34
# Maximum query rewrites before the Article 14 structured refusal.
MAX_REWRITES=2
# Chunking parameters (characters).
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- Compliance / audit -----------------------------------------------------
# EU AI Act Article 12 audit trail (JSONL, append-only, PII-scrubbed).
LOG_DIR="logs"
# Disk cache for on-demand chunk embeddings.
EMBEDDING_CACHE_DIR="data/embedding_cache"
